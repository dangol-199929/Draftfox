# Copy this file to .env to change settings. Everything here is optional.

# Where Ollama is running (default: this computer)
OLLAMA_URL=http://localhost:11434

# Which model to use. Download it first with: ollama pull <model>
OLLAMA_MODEL=gemma4:12b
# LinkedIn app Client ID, from the Auth tab of your app at linkedin.com/developers (only for the LinkedIn page)
LINKEDIN_CLIENT_ID=

# LinkedIn app Primary Client Secret, from the same Auth tab. Keep it secret.
LINKEDIN_CLIENT_SECRET=

# Where LinkedIn sends you back after sign-in (default: http://localhost:3000/api/linkedin/callback)
LINKEDIN_REDIRECT_URI=
