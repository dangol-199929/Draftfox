# Copy this file to .env to change settings. Everything here is optional except the login.

# Login: every page needs your password. Set it with `pnpm set-password`, which fills in these two
# (a scrypt hash of the password and the key that signs sessions). Restart the app after changing them.
DRAFTFOX_PASSWORD_HASH=
AUTH_SECRET=

# Video Studio: the token the video worker (worker/) sends to the worker API. Any long random string; the worker
# reads it from this same file. Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WORKER_TOKEN=
# The Ollama model that writes video scripts (separate from OLLAMA_MODEL, which writes posts).
# See DraftfoxHub/benchmarks/script-models.md for how the models compared on this PC.
VIDEO_SCRIPT_MODEL=
# How long one Ollama request may take before it's given up, in milliseconds (default 5 minutes)
OLLAMA_TIMEOUT_MS=

# Where Ollama is running (default: this computer)
OLLAMA_URL=http://localhost:11434

# Which model to use. Download it first with: ollama pull <model>
OLLAMA_MODEL=gemma4:12b

# What makes images: mflux (Apple silicon Macs), comfyui (Windows/Linux with an NVIDIA GPU) or ollama.
# Left empty, it's mflux on Apple silicon Macs and comfyui everywhere else. See "Images" in the README.
IMAGE_ENGINE=
# Where ComfyUI runs (the desktop app uses port 8000, the portable version 8188)
COMFYUI_URL=http://127.0.0.1:8000

# LinkedIn app Client ID, from the Auth tab of your app at linkedin.com/developers (only for the LinkedIn page)
LINKEDIN_CLIENT_ID=

# LinkedIn app Primary Client Secret, from the same Auth tab. Keep it secret.
LINKEDIN_CLIENT_SECRET=

# Where LinkedIn sends you back after sign-in (default: http://localhost:3000/api/linkedin/callback)
LINKEDIN_REDIRECT_URI=

# Google OAuth client (Web application) from console.cloud.google.com, for uploading videos to YouTube (optional)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Where Google sends you back after sign-in (default: http://localhost:3000/api/youtube/callback)
YOUTUBE_REDIRECT_URI=

# Free Adzuna API key from developer.adzuna.com, so Find jobs on the Jobs page also searches local jobs (optional)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# RapidAPI key for JSearch (rapidapi.com, search "JSearch", subscribe to the free Basic plan), so Find jobs also
# shows jobs Google for Jobs found on LinkedIn, Indeed, Glassdoor and others (optional)
JSEARCH_API_KEY=

# Free Jooble API key from jooble.org/api/about, so Find jobs also searches Jooble (optional)
JOOBLE_API_KEY=

# Careerjet (careerjet.com/partners/api) only answers searches from internet addresses registered in your account,
# which suits a hosted site, not this app on your computer. Off unless CAREERJET_ENABLED=1.
CAREERJET_ENABLED=
CAREERJET_API_KEY=
